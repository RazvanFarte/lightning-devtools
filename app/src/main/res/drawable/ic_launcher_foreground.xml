<?xml version="1.0" encoding="utf-8"?>
<!--
  The glyph reads "<bolt>": angle brackets for "developer tool", a lightning bolt at the centre
  for the Lightning-Browser lineage. All geometry sits inside the 66dp adaptive-icon safe zone
  (radius 33 around the 54,54 centre) so no launcher mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M34,38 L22,54 L34,70"
        android:strokeColor="#F4FBF8"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:strokeAlpha="0.92"/>

    <path
        android:pathData="M74,38 L86,54 L74,70"
        android:strokeColor="#F4FBF8"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:strokeAlpha="0.92"/>

    <path android:pathData="M56,34 L36,58 L54,58 L52,74 L72,50 L54,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36" android:startY="34"
                android:endX="72" android:endY="74">
                <item android:offset="0" android:color="#FF37F5B0"/>
                <item android:offset="1" android:color="#FF0FD68A"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
